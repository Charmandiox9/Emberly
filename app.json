{
  "expo": {
    "name": "Emberly",
    "slug": "emberly",
    "version": "0.1.0",
    "scheme": "emberly",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/ember/ember-companion.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF1E6"
    },
    "platforms": ["android"],
    "android": {
      "package": "com.charmandiox9.emberly",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que Emberly use la cámara para fotografiar comprobantes.",
          "photosPermission": "Permite seleccionar fotos para adjuntarlas a tus movimientos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
